    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "-cn att_config experiment=start_att_backbone"
        },
        {
            "name": "Python Debugger: Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "--cfg configs/projects/tadaformer/soccer/tadaformer_l14_soccer_test.yaml"
        }
    ]
}